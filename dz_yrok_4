    print("Числа рівні")

# дз 4

while True:
    zadac = int(input("\nВведите, сколько Кириллу нужно задач (от 0 до 10): "))

    if zadac == 0:
        print("ЗАНОВО ПИШИ, ему этого мало!")
    elif 1 <= zadac <= 2:
        print("Супер мало")
        break
    elif 3 <= zadac <= 5:
        print("Мало")
        break
    elif 6 <= zadac <= 8:
        print("+- Нормально")
        break
    elif 9 <= zadac <= 10:
        print("Нормально")
        break
    else:
        print("Ошибка: введите число от 0 до 10!")
          
