import tkinter as tk

score = 0
cluc = 1
ctoumosti = 10
time_left = 30

def add_point():
    global score
    global cluc
    score += cluc

def obnova():
    global score
    global cluc
    score_label.config(text=f"Кликов: {score}")
    cluc_label.config(text=f"Сила клика: {cluc}")
    time_label.config(text=f"Время {time_left} сек")
    upgade_button.config(text=f"Стоимость {ctoumosti} +2 кликов за клик", font=("Arial", 14), command=upgade)
    window.after(1000, obnova)


def upgade():
    global score
    global cluc
    global ctoumosti
    if score >= ctoumosti:
        cluc += 2
        score -= ctoumosti
        if cluc >= 10:
            ctoumosti = 25
    else:
        pass

def tick():
    global time_left
    window.after(1000, tick)
    time_left -= 1

def vremya():
    window.after(1000, vremya)
    if time_left <= 0:
        window.destroy()

window = tk.Tk()
window.title("Academy Clicker")
window.geometry("320x220")

title_label = tk.Label(window, text="Academy Clicker", font=("Arial", 18, "bold"))
title_label.pack(pady=12)

score_label = tk.Label(window, text="Кликов: 0", font=("Arial", 14))
score_label.pack(pady=8)

cluc_label = tk.Label(window, text="Сила клика: 1", font=("Arial", 14))
cluc_label.pack(pady=8)

time_label = tk.Label(window, text="Время 30 сек", font=("Arial", 14))
time_label.pack(pady=8)

click_button = tk.Button(window, text="Click", font=("Arial", 14), command=add_point)
click_button.pack(pady=16)

upgade_button = tk.Button(window, text=f"Стоимость {ctoumosti} +2 кликов за клик", font=("Arial", 14), command=upgade)
upgade_button.pack(pady=16)

obnova()
tick()
vremya()

window.mainloop()
